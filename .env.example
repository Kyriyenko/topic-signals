APP_ENV=local

REDIS_HOST=redis
REDIS_PORT=6379
ARTICLE_CACHE_TTL_SECONDS=604800
PAGEVIEWS_CACHE_TTL_SECONDS=86400

CHART_OUTPUT_DIR=/var/www/topic-signals/var/charts
REPORT_OUTPUT_DIR=/var/www/topic-signals/var/reports

CHART_PYTHON_BIN=/opt/chart-venv/bin/python
CHART_SCRIPT_PATH=/var/www/topic-signals/docker/chart/render.py

WIKIMEDIA_USER_AGENT="topic-signals-skill/1.0 (https://github.com/Kyriyenko/topic-signals)"
