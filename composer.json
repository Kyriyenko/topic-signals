{
    "name": "topic-signals/wikipedia-topic-signals-skill",
    "description": "Agent Skill: analyze Wikipedia pageviews to assess B2C topic and language interest",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "symfony/console": "^7.1",
        "symfony/validator": "^7.1",
        "guzzlehttp/guzzle": "^7.9",
        "predis/predis": "^2.3",
        "dompdf/dompdf": "^3.1",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "TopicSignals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TopicSignals\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
